@page
@model IndexModel
@{
    ViewData["Title"] = "FlowForge";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<header class="main-header">
    <h1>FlowForge</h1>
    <p>Smart Task Productivity System</p>

    <div class="theme-control">
        <label for="themeSelect">Theme:</label>
        <select id="themeSelect">
            <option value="default">Default</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
            <option value="forest">Forest</option>
            <option value="ocean">Ocean</option>
            <option value="sunset">Sunset</option>
            <option value="frenzy">Frenzy</option>
        </select>
    </div>
</header>

<main>
    <section class="task-container">
        <h2>Add New Task</h2>

        <div class="task-form">
            <input type="text" id="taskInput" placeholder="Enter a task...">

            <select id="prioritySelect">
                <option value="low">Low Priority</option>
                <option value="medium">Medium Priority</option>
                <option value="high">High Priority</option>
            </select>

            <select id="categorySelect">
                <option value="school">School</option>
                <option value="work">Work</option>
                <option value="personal">Personal</option>
                <option value="other">Other</option>
            </select>

            <input type="date" id="dueDateInput">

            <button id="addTaskBtn">Add Task</button>
        </div>

        <section id="notificationPanel" class="notification-panel hidden">
            <h2>Smart Reminders</h2>
            <div id="notificationList"></div>
        </section>

        <section id="suggestionPanel" class="suggestion-panel hidden">
            <h2>Smart Suggestions</h2>
            <div id="suggestionList"></div>
        </section>

        <section class="dashboard-stats">
            <div class="stat-card">
                <h3>Total Tasks</h3>
                <p id="totalTasks">0</p>
            </div>

            <div class="stat-card">
                <h3>Completed</h3>
                <p id="completedTasks">0</p>
            </div>

            <div class="stat-card">
                <h3>Pending</h3>
                <p id="pendingTasks">0</p>
            </div>

            <div class="stat-card">
                <h3>Overdue</h3>
                <p id="overdueTasks">0</p>
            </div>

            <div class="stat-card">
                <h3>Created This Week</h3>
                <p id="createdThisWeek">0</p>
            </div>

            <div class="stat-card">
                <h3>Completed This Week</h3>
                <p id="completedThisWeek">0</p>
            </div>
        </section>

        <section class="goal-section">
            <h2>Weekly Goal Tracking</h2>

            <div class="goal-card">
                <div class="goal-controls">
                    <label for="weeklyGoalInput">Weekly Goal:</label>
                    <input type="number" id="weeklyGoalInput" min="1" placeholder="Example: 10">
                    <button id="saveGoalBtn">Set Goal</button>
                </div>

                <p id="goalProgressText">No weekly goal set.</p>

                <div class="goal-progress-bar">
                    <div id="goalProgressFill" class="goal-progress-fill"></div>
                </div>

                <p id="goalPercentText">0%</p>
            </div>
        </section>

        <section class="analytics-section">
            <h2>Productivity Analytics</h2>

            <div class="chart-card">
                <h3>Completed vs Pending</h3>
                <canvas id="taskStatusChart"></canvas>
            </div>
        </section>

        <ul id="taskList"></ul>
    </section>
</main>

<div id="editModal" class="modal-overlay hidden">
    <div class="modal-card">
        <h2>Edit Task</h2>

        <label for="editTaskInput">Task Name</label>
        <input type="text" id="editTaskInput">

        <label for="editPrioritySelect">Priority</label>
        <select id="editPrioritySelect">
            <option value="low">Low Priority</option>
            <option value="medium">Medium Priority</option>
            <option value="high">High Priority</option>
        </select>

        <label for="editCategorySelect">Category</label>
        <select id="editCategorySelect">
            <option value="school">School</option>
            <option value="work">Work</option>
            <option value="personal">Personal</option>
            <option value="other">Other</option>
        </select>

        <label for="editDueDateInput">Due Date</label>
        <input type="date" id="editDueDateInput">

        <div class="modal-buttons">
            <button type="button" id="saveEditBtn">Save Changes</button>
            <button type="button" id="cancelEditBtn">Cancel</button>
        </div>
    </div>
</div>